# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_CHANNEL_SECRET=your_channel_secret

# OpenAI API
OPENAI_API_KEY=your_openai_api_key

# ============================================
# 航空券価格比較 API（推奨）
# ============================================

# RapidAPI (Sky Scrapper - Skyscanner データ)
# 登録: https://rapidapi.com/apiheya/api/sky-scrapper
# 無料枠: 100リクエスト/月
RAPIDAPI_KEY=your_rapidapi_key

# Travelpayouts（アフィリエイト収益化）
# 登録: https://www.travelpayouts.com/
# 無料
TRAVELPAYOUTS_TOKEN=your_travelpayouts_token
TRAVELPAYOUTS_MARKER=your_marker_id

# ============================================
# 旧API（非推奨 - 代わりにRapidAPIを使用）
# ============================================

# Amadeus API（オプション - Phase 2）
# AMADEUS_API_KEY=your_amadeus_api_key
# AMADEUS_API_SECRET=your_amadeus_api_secret

# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_PATH=./data/flight-bot.db

# 外務省API（無料）
# https://www.anzen.mofa.go.jp/
