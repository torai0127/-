# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_CHANNEL_SECRET=your_channel_secret

# Server
PORT=3000
NODE_ENV=development

# 転送先URL設定
# 海外相談ボット
CONSULTATION_BOT_URL=http://localhost:3000/webhook
# 航空券ボット
FLIGHT_BOT_URL=http://localhost:3001/webhook

# Lステップ/エルメのWebhook URL（どちらか一方を設定）
# Lステップの場合
LSTEP_WEBHOOK_URL=
# エルメの場合
ELME_WEBHOOK_URL=

# どちらを使用するか（lstep または elme）
MA_TOOL=lstep

# デフォルトの転送先（consultation / flight / ma）
DEFAULT_FORWARD=ma

# データベース
DATABASE_PATH=./data/proxy.db
